<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        行级权限（记录规则）

        设计原则：
        1. 销售员（group_cement_sales_user）只能看到/改到自己名下的记录。
        2. 销售主管（group_cement_sales_manager）、会计组可见全部。
        3. 未命中任何规则的组（如 stock.group_stock_user）不受限制，可见全部。
           这是 Odoo 的默认语义：只有「适用到当前用户的规则」才会参与过滤。
    -->

    <!-- ==================== 分组 ==================== -->
    <record id="group_cement_sales_user" model="res.groups">
        <field name="name">水泥销售员</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <!-- uom.group_uom（多计量单位）：水泥按袋卖、按吨对账，必须打开这个开关，
             订单行上才会显示「单位」列，否则数量旁边看不到「袋」字。 -->
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('uom.group_uom'))]"/>
        <field name="comment">可管理自己名下的水泥客户、跟进、回款与交付记录。已启用多计量单位，订单行会显示「袋」等单位。</field>
    </record>

    <record id="group_cement_sales_manager" model="res.groups">
        <field name="name">水泥销售主管</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_cement_sales_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="comment">可查看与管理全部销售员的水泥业务数据。同时拥有销售模块「查看所有单据」权限，否则仍会被 sale 自带的个人单据规则挡住。</field>
    </record>

    <!-- ==================== cement.customer ==================== -->
    <record id="rule_cement_customer_salesman" model="ir.rule">
        <field name="name">水泥客户：销售员仅见本人负责</field>
        <field name="model_id" ref="model_cement_customer"/>
        <field name="domain_force">[('sales_person', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_user'))]"/>
    </record>

    <record id="rule_cement_customer_manager" model="ir.rule">
        <field name="name">水泥客户：主管与会计可见全部</field>
        <field name="model_id" ref="model_cement_customer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_manager')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <!-- ==================== cement.followup ==================== -->
    <record id="rule_cement_followup_salesman" model="ir.rule">
        <field name="name">跟进记录：销售员仅见本人</field>
        <field name="model_id" ref="model_cement_followup"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_user'))]"/>
    </record>

    <record id="rule_cement_followup_manager" model="ir.rule">
        <field name="name">跟进记录：主管与会计可见全部</field>
        <field name="model_id" ref="model_cement_followup"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_manager')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <!-- ==================== cement.delivery ====================
         cement.delivery 没有自己的销售员字段，沿「客户 -> 销售员」判断归属。
    -->
    <record id="rule_cement_delivery_salesman" model="ir.rule">
        <field name="name">交付记录：销售员仅见本人客户</field>
        <field name="model_id" ref="model_cement_delivery"/>
        <field name="domain_force">[('customer_id.sales_person', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_user'))]"/>
    </record>

    <record id="rule_cement_delivery_manager" model="ir.rule">
        <field name="name">交付记录：主管与会计可见全部</field>
        <field name="model_id" ref="model_cement_delivery"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_manager')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <!-- ==================== cement.payment ==================== -->
    <record id="rule_cement_payment_salesman" model="ir.rule">
        <field name="name">回款记录：销售员仅见本人</field>
        <field name="model_id" ref="model_cement_payment"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_user'))]"/>
    </record>

    <record id="rule_cement_payment_manager" model="ir.rule">
        <field name="name">回款记录：主管与会计可见全部</field>
        <field name="model_id" ref="model_cement_payment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cement_sales_manager')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <!-- ==================== 多公司 ====================
         以下四条不设 groups，属于全局规则，对所有用户无条件生效，
         并与上面的业务规则取交集（全局规则 AND 组规则）。
    -->
    <record id="rule_cement_customer_company" model="ir.rule">
        <field name="name">水泥客户：多公司</field>
        <field name="model_id" ref="model_cement_customer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cement_followup_company" model="ir.rule">
        <field name="name">跟进记录：多公司</field>
        <field name="model_id" ref="model_cement_followup"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cement_delivery_company" model="ir.rule">
        <field name="name">交付记录：多公司</field>
        <field name="model_id" ref="model_cement_delivery"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cement_payment_company" model="ir.rule">
        <field name="name">回款记录：多公司</field>
        <field name="model_id" ref="model_cement_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
