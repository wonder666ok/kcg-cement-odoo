<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 预存款流水 -->
    <record id="view_cement_prepaid_transaction_list" model="ir.ui.view">
        <field name="name">cement.prepaid.transaction.list</field>
        <field name="model">cement.prepaid.transaction</field>
        <field name="arch" type="xml">
            <list string="预存款流水" decoration-danger="amount &lt; 0"
                  decoration-success="amount &gt; 0">
                <field name="date"/>
                <field name="customer_id"/>
                <field name="type" widget="badge"
                       decoration-info="type == 'recharge'"
                       decoration-warning="type == 'deduction'"/>
                <field name="amount"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="delivery_id" optional="show"/>
                <field name="note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cement_prepaid_transaction_form" model="ir.ui.view">
        <field name="name">cement.prepaid.transaction.form</field>
        <field name="model">cement.prepaid.transaction</field>
        <field name="arch" type="xml">
            <form string="预存款流水">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="type" readonly="type == 'deduction'"/>
                            <field name="amount"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="sale_order_id" readonly="type == 'deduction'"/>
                            <field name="delivery_id" readonly="type == 'deduction'"/>
                            <field name="note"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cement_prepaid_transaction_search" model="ir.ui.view">
        <field name="name">cement.prepaid.transaction.search</field>
        <field name="model">cement.prepaid.transaction</field>
        <field name="arch" type="xml">
            <search string="预存款流水">
                <field name="customer_id"/>
                <field name="sale_order_id"/>
                <field name="delivery_id"/>
                <field name="note"/>
                <filter name="filter_recharge" string="充值"
                        domain="[('type', '=', 'recharge')]"/>
                <filter name="filter_deduction" string="发货扣款"
                        domain="[('type', '=', 'deduction')]"/>
                <filter name="filter_refund" string="退款"
                        domain="[('type', '=', 'refund')]"/>
                <filter name="filter_adjust" string="调整"
                        domain="[('type', '=', 'adjust')]"/>
                <group expand="0" string="分组">
                    <filter name="group_by_type" string="按类型"
                            context="{'group_by': 'type'}"/>
                    <filter name="group_by_customer" string="按客户"
                            context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cement_prepaid_transaction" model="ir.actions.act_window">
        <field name="name">预存款流水</field>
        <field name="res_model">cement.prepaid.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_customer': 1}</field>
    </record>

    <menuitem id="menu_cement_prepaid_root" name="预存款管理"
              parent="menu_cement_sales_root" sequence="30"/>
    <menuitem id="menu_cement_prepaid_transaction" name="预存款流水"
              parent="menu_cement_prepaid_root"
              action="action_cement_prepaid_transaction" sequence="10"/>

    <!-- 充值向导 -->
    <record id="view_cement_prepaid_recharge_form" model="ir.ui.view">
        <field name="name">cement.prepaid.recharge.form</field>
        <field name="model">cement.prepaid.recharge</field>
        <field name="arch" type="xml">
            <form string="客户预存款充值">
                <group>
                    <field name="customer_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount"/>
                    <field name="note" placeholder="备注（收款方式等）"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="确认充值"
                            class="btn-primary"/>
                    <button string="取消" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 客户表单：预存款 -->
    <record id="view_cement_customer_form_prepaid" model="ir.ui.view">
        <field name="name">cement.customer.form.prepaid</field>
        <field name="model">cement.customer</field>
        <field name="inherit_id" ref="cement_sales.view_cement_customer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_recharge_prepaid" type="object"
                        class="oe_stat_button" icon="fa-plus-circle"
                        invisible="not is_prepaid">
                    <div class="o_stat_info">
                        <span class="o_stat_text">充值</span>
                        <span class="o_stat_text">预存款</span>
                    </div>
                </button>
                <button name="action_view_prepaid_transactions" type="object"
                        class="oe_stat_button" icon="fa-credit-card"
                        invisible="not is_prepaid">
                    <field name="prepaid_balance" widget="statinfo" string="预存款余额"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='customer_status']" position="after">
                <field name="is_prepaid"/>
                <field name="prepaid_currency_id" invisible="1"/>
                <field name="prepaid_balance" invisible="not is_prepaid"/>
                <field name="prepaid_count" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- 客户列表：预存款余额列 -->
    <record id="view_cement_customer_list_prepaid" model="ir.ui.view">
        <field name="name">cement.customer.list.prepaid</field>
        <field name="model">cement.customer</field>
        <field name="inherit_id" ref="cement_sales.view_cement_customer_list"/>
        <field name="arch" type="xml">
            <field name="total_sales_amount" position="after">
                <field name="prepaid_currency_id" column_invisible="1"/>
                <field name="prepaid_balance" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
