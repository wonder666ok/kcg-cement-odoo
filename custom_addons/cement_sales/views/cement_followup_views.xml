<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cement_followup_search" model="ir.ui.view">
        <field name="name">cement.followup.search</field>
        <field name="model">cement.followup</field>
        <field name="arch" type="xml">
            <search string="跟进记录">
                <field name="subject"/>
                <field name="customer_id"/>
                <field name="salesperson_id"/>
                <field name="followup_type"/>
                <filter name="my_followups" string="我的跟进" domain="[('salesperson_id', '=', uid)]"/>
                <filter name="pending" string="待跟进" domain="[('state', '=', 'pending')]"/>
                <filter name="due" string="到期/逾期" domain="[('state', '=', 'pending'), ('next_followup_date', '&lt;=', context_today())]"/>
                <separator/>
                <filter name="group_salesperson" string="销售员" context="{'group_by': 'salesperson_id'}"/>
                <filter name="group_state" string="状态" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="跟进类型" context="{'group_by': 'followup_type'}"/>
                <filter name="group_result" string="结果" context="{'group_by': 'result'}"/>
                <filter name="group_customer" string="客户" context="{'group_by': 'customer_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cement_followup_list" model="ir.ui.view">
        <field name="name">cement.followup.list</field>
        <field name="model">cement.followup</field>
        <field name="arch" type="xml">
            <list string="跟进记录" default_order="next_followup_date asc, date desc">
                <field name="date"/>
                <field name="customer_id"/>
                <field name="subject"/>
                <field name="followup_type"/>
                <field name="salesperson_id"/>
                <field name="state" widget="badge"/>
                <field name="result"/>
                <field name="next_followup_date"/>
            </list>
        </field>
    </record>

    <record id="view_cement_followup_form" model="ir.ui.view">
        <field name="name">cement.followup.form</field>
        <field name="model">cement.followup</field>
        <field name="arch" type="xml">
            <form string="跟进记录">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="subject" string="主题"/>
                        <h1><field name="subject" placeholder="例如：确认散装水泥报价"/></h1>
                    </div>
                    <group>
                        <group string="跟进信息">
                            <field name="customer_id"/>
                            <field name="date"/>
                            <field name="followup_type"/>
                            <field name="salesperson_id"/>
                        </group>
                        <group string="跟进计划">
                            <field name="state"/>
                            <field name="result"/>
                            <field name="next_followup_date"/>
                        </group>
                    </group>
                    <group string="跟进备注">
                        <field name="notes" nolabel="1" placeholder="记录客户需求、报价数量、交付地点或后续事项..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cement_followup_action" model="ir.actions.act_window">
        <field name="name">跟进记录</field>
        <field name="res_model">cement.followup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cement_followup_search"/>
    </record>

    <record id="action_cement_my_followups" model="ir.actions.act_window">
        <field name="name">我的跟进</field>
        <field name="res_model">cement.followup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cement_followup_search"/>
        <field name="context">{'search_default_my_followups': 1, 'search_default_pending': 1}</field>
    </record>

    <menuitem id="menu_cement_followup_all" name="跟进记录"
              parent="menu_cement_sales_root" action="cement_followup_action" sequence="20"
              groups="cement_sales.group_cement_sales_user,account.group_account_invoice,account.group_account_readonly"/>
    <menuitem id="menu_cement_followup_mine" name="我的跟进"
              parent="menu_cement_sales_root" action="action_cement_my_followups" sequence="21"
              groups="cement_sales.group_cement_sales_user,account.group_account_invoice,account.group_account_readonly"/>
</odoo>
