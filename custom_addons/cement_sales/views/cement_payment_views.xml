<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cement_payment_search" model="ir.ui.view">
        <field name="name">cement.payment.search</field>
        <field name="model">cement.payment</field>
        <field name="arch" type="xml">
            <search string="回款管理">
                <field name="customer_id"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <field name="salesperson_id"/>
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="reference"/>
                <filter name="my_cement_payments" string="我的回款"
                        domain="[('salesperson_id', '=', uid)]"/>
                <filter name="draft_cement_payments" string="草稿"
                        domain="[('status', '=', 'draft')]"/>
                <filter name="confirmed_cement_payments" string="已确认"
                        domain="[('status', '=', 'confirmed')]"/>
                <filter name="cancelled_cement_payments" string="已取消"
                        domain="[('status', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_customer" string="按客户"
                            context="{'group_by': 'customer_id'}"/>
                    <filter name="group_salesperson" string="按销售员"
                            context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_status" string="按状态"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_payment_method" string="按回款方式"
                            context="{'group_by': 'payment_method'}"/>
                    <filter name="group_payment_month" string="按月份"
                            context="{'group_by': 'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cement_payment_list" model="ir.ui.view">
        <field name="name">cement.payment.list</field>
        <field name="model">cement.payment</field>
        <field name="arch" type="xml">
            <list string="回款管理" default_order="payment_date desc, id desc"
                  decoration-success="status == 'confirmed'"
                  decoration-muted="status == 'cancelled'">
                <field name="payment_date"/>
                <field name="customer_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="invoice_id" optional="show"/>
                <field name="salesperson_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id"/>
                <field name="payment_method"/>
                <field name="reference" optional="hide"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cement_payment_form" model="ir.ui.view">
        <field name="name">cement.payment.form</field>
        <field name="model">cement.payment</field>
        <field name="arch" type="xml">
            <form string="水泥销售回款">
                <header>
                    <button name="action_confirm" type="object" string="确认"
                            class="oe_highlight" invisible="status != 'draft'"
                            groups="account.group_account_invoice"/>
                    <button name="action_cancel" type="object" string="取消"
                            invisible="status != 'draft'"/>
                    <button name="action_reset_to_draft" type="object" string="重置为草稿"
                            invisible="status != 'cancelled'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,confirmed,cancelled"/>
                    <button name="action_open_native_payment" type="object"
                            string="打开原生会计付款" class="oe_highlight"
                            icon="fa-credit-card" invisible="not native_payment_id"
                            groups="account.group_account_invoice,account.group_account_readonly"/>
                </header>
                <sheet>
                    <group>
                        <group string="基本信息">
                            <field name="customer_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="customer_commercial_partner_id" invisible="1"/>
                            <field name="sale_order_id"
                                   domain="[('cement_customer_id', '=', customer_id)]"/>
                            <field name="invoice_id"
                                   domain="[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('commercial_partner_id', '=', customer_commercial_partner_id)]"/>
                            <field name="payment_journal_id"
                                   groups="account.group_account_invoice"
                                   domain="[('company_id', '=', company_id), ('type', 'in', ['bank', 'cash'])]"/>
                            <field name="native_payment_id" readonly="1"
                                   groups="account.group_account_invoice,account.group_account_readonly"/>
                            <field name="payment_date"/>
                            <field name="salesperson_id"/>
                        </group>
                        <group string="金额信息">
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="payment_method"/>
                        </group>
                    </group>
                    <group string="其他">
                        <field name="reference"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cement_payment_all" model="ir.actions.act_window">
        <field name="name">全部回款</field>
        <field name="res_model">cement.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cement_payment_search"/>
    </record>
    <record id="action_cement_payment_mine" model="ir.actions.act_window">
        <field name="name">我的回款</field>
        <field name="res_model">cement.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cement_payment_search"/>
        <field name="context">{'search_default_my_cement_payments': 1}</field>
    </record>

    <!-- 手动补录：把已过账但未同步的原生收款补成回款记录 -->
    <record id="action_cement_payment_sync" model="ir.actions.server">
        <field name="name">同步原生收款</field>
        <field name="model_id" ref="model_cement_payment"/>
        <field name="code">action = model.action_sync_native_payments()</field>
    </record>

    <menuitem id="menu_cement_payment_root" name="回款管理"
              parent="menu_cement_sales_root" sequence="25"
              groups="cement_sales.group_cement_sales_user,account.group_account_invoice,account.group_account_readonly"/>
    <menuitem id="menu_cement_payment_all" name="全部回款"
              parent="menu_cement_payment_root" action="action_cement_payment_all"
              sequence="10"
              groups="cement_sales.group_cement_sales_user,account.group_account_invoice,account.group_account_readonly"/>
    <menuitem id="menu_cement_payment_mine" name="我的回款"
              parent="menu_cement_payment_root" action="action_cement_payment_mine"
              sequence="20"
              groups="cement_sales.group_cement_sales_user,account.group_account_invoice,account.group_account_readonly"/>
    <menuitem id="menu_cement_payment_sync" name="同步原生收款"
              parent="menu_cement_payment_root" action="action_cement_payment_sync"
              sequence="30"
              groups="cement_sales.group_cement_sales_manager,account.group_account_invoice,account.group_account_readonly"/>
</odoo>
