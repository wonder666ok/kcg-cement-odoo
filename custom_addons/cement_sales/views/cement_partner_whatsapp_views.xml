<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 联系人表单：WhatsApp 按钮 + 电话旁的快捷发送图标 -->
    <record id="view_partner_form_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_send_whatsapp" type="object"
                        class="oe_stat_button" icon="fa-whatsapp"
                        invisible="not (phone or mobile)">
                    <div class="o_stat_info">
                        <span class="o_stat_text">WhatsApp</span>
                        <span class="o_stat_text">发消息</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='phone']" position="before">
                <button name="action_send_whatsapp" type="object"
                        class="btn btn-link p-0 me-1" icon="fa-whatsapp"
                        title="通过 WhatsApp 发送消息"
                        invisible="not phone and not mobile"/>
            </xpath>
        </field>
    </record>
</odoo>
