<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            定位数据保留天数。定位表是时序数据，不设保留策略会无限膨胀：
            7 辆车按 10 秒一个点约每天 6 万条，50 辆车约每天 43 万条。
            设 0 或负数可关闭清理（调试用）。
        -->
        <record id="param_retention_days" model="ir.config_parameter">
            <field name="key">kcg_gps_tracking.retention_days</field>
            <field name="value">90</field>
        </record>

        <!--
            超期定位清理任务。

            Odoo 18 的 ir.cron 通过 delegate 关联 ir.actions.server，
            所以 model_id / state / code 直接写在本记录上即可，不需要单独建 server action。
        -->
        <record id="ir_cron_gps_purge_positions" model="ir.cron">
            <field name="name">KCG GPS: 清理超期定位记录</field>
            <field name="model_id" ref="model_gps_position"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_old_positions()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">8</field>
        </record>
    </data>
</odoo>
